{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "small_model": "opencode-go/deepseek-v4-flash",
  "default_agent": "free-build",
  "subagent_depth": 2,
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "deny",
    "websearch": "deny"
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      "build/**",
      "coverage/**",
      "**/.DS_Store",
      ".opencode/snapshots/**"
    ]
  },
  "formatter": true,
  "lsp": true
}
