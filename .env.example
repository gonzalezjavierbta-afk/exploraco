# =====================================================================
# ExploraCO - Plantilla de variables de entorno (.env.example)
# =====================================================================
# Copia este archivo a .env (local) o configura cada variable en el
# dashboard de Vercel (Production / Preview / Development).
#
# REGLAS:
#   - NUNCA poner valores reales ni secretos en este archivo.
#   - .env, .env.local y .env.*.local estan en .gitignore.
#   - Este archivo .env.example SI se versiona (plantilla publica).
#   - Los valores marcados [OBLIGATORIA EN PRODUCCION] deben existir antes
#     de anunciar cualquier release. Si faltan, el codigo cae a fallbacks
#     publicos inseguros.
# =====================================================================

# ---------------------------------------------------------------------
# BASE DE DATOS (Neon) - [OBLIGATORIA EN PRODUCCION]
# ---------------------------------------------------------------------
# Connection string de Neon (PostgreSQL serverless). Usada por todos los
# endpoints de api/*.js. Sin ella, toda lectura/escritura falla.
# Formato: postgresql://usuario:password@host/db?sslmode=require
DATABASE_URL=

# ---------------------------------------------------------------------
# AUTENTICACION ADMIN - [OBLIGATORIA EN PRODUCCION]
# ---------------------------------------------------------------------
# Secreto del header "Authorization: Bearer <ADMIN_SECRET>" que protege
# los endpoints de administracion (api/admin.js, api/admin-destinos.js,
# api/utilidades.js, api/interacciones.js). Tambien viaja como
# "X-Internal-Secret" entre funciones serverless.
# Si falta, el codigo usa el fallback publico 'exploraco12345'
# (INSEGURO en produccion: cualquiera podria moderar/administrar).
ADMIN_SECRET=

# ---------------------------------------------------------------------
# JWT DE SESION - [OBLIGATORIA EN PRODUCCION]
# ---------------------------------------------------------------------
# Secreto HMAC-SHA256 con el que api/usuarios.js FIRMA el token de sesion
# (firmarSesion) y api/interacciones.js lo VALIDA (validarSesion). Debe
# ser el MISMO valor en todas las funciones serverless del proyecto.
# Si falta, el codigo cae al fallback publico 'dev_secret' y los tokens
# de sesion serian falsificables (cualquiera podria suplantar usuarios).
# Generar uno aleatorio fuerte, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_JWT_SECRET=

# ---------------------------------------------------------------------
# CORREO (Resend) - [OBLIGATORIA EN PRODUCCION para email]
# ---------------------------------------------------------------------
# API key de Resend. La usan api/admin.js (correos de notificacion) y
# api/usuarios.js (verificacion de email). Sin ella, el envio de correo
# devuelve 503 EMAIL_NO_CONFIGURADO.
RESEND_API_KEY=

# ---------------------------------------------------------------------
# ALMACENAMIENTO DE ARCHIVOS (Vercel Blob) - [OBLIGATORIA para subidas]
# ---------------------------------------------------------------------
# Token read-write del store Blob que recibe las subidas de imagenes, audio
# y video (foto 5 MB / audio 15 MB / video 30 MB). Lo usan:
#   - api/blob-upload.js (emite tokens de client upload y valida limites).
# Si falta, las subidas responden 503 ALMACENAMIENTO_NO_CONFIGURADO; el resto
# del sitio sigue funcionando (se puede seguir pegando URLs externas).
# En Vercel se inyecta solo al conectar el store (Storage -> Blob). Para
# desarrollo local: `vercel env pull .env.local`.
# IMPORTANTE: la subida anonima solo aplica a la foto principal del alta de
# destinos (publicar.html); el resto exige sesion de usuario o admin.
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------
# OPCIONALES / NO SECRETAS
# ---------------------------------------------------------------------

# Destinatario de los correos de notificacion del admin.
# Default en codigo: admin@exploraco.co
ADMIN_EMAIL=

# URL publica base del sitio, usada para construir el enlace de
# verificacion de correo (api/usuarios.js).
# Default en codigo: https://exploraco.vercel.app
# En produccion con dominio propio: https://exploraco.co
SITE_URL=

# ---------------------------------------------------------------------
# SOLO DESARROLLO - NO CONFIGURAR EN PRODUCCION
# ---------------------------------------------------------------------

# Si vale exactamente 'true', api/usuarios.js devuelve debug_token en la
# respuesta de email_verificar_solicitar cuando RESEND_API_KEY no esta
# configurada, para poder verificar el correo en local sin servidor de
# correo. Debe quedar AUSENTE o en 'false' en produccion.
DEV_EMAIL_ECHO=

# ---------------------------------------------------------------------
# AUTO-INYECTADAS POR VERCEL - NO CONFIGURAR MANUALMENTE
# ---------------------------------------------------------------------
# VERCEL_URL: la inyecta Vercel en runtime (api/publicar-lugar.js y
#   api/interacciones.js la usan como base de URL interna con fallback).
# BASE_URL: solo la usan scripts locales de verificacion
#   (scripts/verify_comunidad_prod.js); no es una variable del backend.
